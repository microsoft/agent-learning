        <UserObject label="&lt;b&gt;Active Policy Snapshot&lt;/b&gt;&#xa;Holds the exact version, logits, authority, complexity metadata, and actions." mermaidId="n:SNAPSHOT" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#eaf4e8;strokeColor=#4d7047;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;Active Policy Snapshot&lt;/b&gt;&#xa;Holds the exact version, logits, authority, complexity metadata, and actions." id="JbiP2ET93n0CbPQwfH8w-5">
