  <diagram id="ETud2h5cpf3wiViEfzXI" name="BuildTime">
    <mxGraphModel dx="1686" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    REQUEST[\&quot;&lt;b&gt;Training Request&lt;/b&gt;&lt;br/&gt;Starts a manual, scheduled, or event-driven offline policy update.\&quot;]\n    STORE[\&quot;&lt;b&gt;Learning Store&lt;/b&gt;&lt;br/&gt;Provides durable episodes, rewards, snapshots, and training-run records.\&quot;]\n    SNAPSHOT[\&quot;&lt;b&gt;Active Policy Snapshot&lt;/b&gt;&lt;br/&gt;Identifies the current low-authority policy state and action taxonomy.\&quot;]\n    ELIGIBILITY[\&quot;&lt;b&gt;Training Eligibility Gate&lt;/b&gt;&lt;br/&gt;Admits a low-authority policy with enough completed episodes for the batch.\&quot;]\n    POLICY[\&quot;&lt;b&gt;Softmax Policy&lt;/b&gt;&lt;br/&gt;Hydrates the active logits and baseline into an updateable runtime policy.\&quot;]\n    RUNNER[\&quot;&lt;b&gt;Learning Runner&lt;/b&gt;&lt;br/&gt;Orchestrates evaluation, reward creation, learning, and persistence.\&quot;]\n    RUN[\&quot;&lt;b&gt;Training Run&lt;/b&gt;&lt;br/&gt;Records batch status, input snapshot, episode IDs, metrics, and errors.\&quot;]\n    EPISODES[\&quot;&lt;b&gt;Completed Episodes&lt;/b&gt;&lt;br/&gt;Supplies durable runtime outcomes and behavior-policy lineage as training evidence.\&quot;]\n    EVALUATORS[\&quot;&lt;b&gt;Metric Evaluators&lt;/b&gt;&lt;br/&gt;Measure intent resolution, task adherence, and task completion.\&quot;]\n    METRICS[\&quot;&lt;b&gt;Metric Results&lt;/b&gt;&lt;br/&gt;Preserves normalized scores, status, rationale, evaluator, and provenance.\&quot;]\n    SHAPER[\&quot;&lt;b&gt;Reward Shaper&lt;/b&gt;&lt;br/&gt;Combines metric scores and configured penalties into one bounded signal.\&quot;]\n    SHAPED[\&quot;&lt;b&gt;Shaped Reward&lt;/b&gt;&lt;br/&gt;Carries the transient aggregate value, contributions, and penalties.\&quot;]\n    WRITER[\&quot;&lt;b&gt;Reward Writer&lt;/b&gt;&lt;br/&gt;Translates metric and shaped values into durable reward records.\&quot;]\n    REWARDS[\&quot;&lt;b&gt;Rewards&lt;/b&gt;&lt;br/&gt;Stores per-metric, penalty, and aggregate signals linked to each episode.\&quot;]\n    LEARNER[\&quot;&lt;b&gt;REINFORCE Learner&lt;/b&gt;&lt;br/&gt;Uses behavior samples and aggregate rewards to calculate one policy update.\&quot;]\n    NEXT[\&quot;&lt;b&gt;Next Policy Snapshot&lt;/b&gt;&lt;br/&gt;Persists advanced logits, baseline, counters, version, and lineage metadata.\&quot;]\n\n    REQUEST --&gt;|requests the active policy from| STORE\n    STORE --&gt;|returns| SNAPSHOT\n    REQUEST --&gt;|is screened by| ELIGIBILITY\n    SNAPSHOT --&gt;|declares authority to| ELIGIBILITY\n    ELIGIBILITY --&gt;|starts an eligible batch in| RUNNER\n    SNAPSHOT --&gt;|hydrates| POLICY\n    POLICY --&gt;|is supplied to| RUNNER\n    RUNNER --&gt;|creates and updates| RUN\n    RUNNER --&gt;|queries completed outcomes through| STORE\n    STORE --&gt;|returns| EPISODES\n    RUNNER --&gt;|invokes| EVALUATORS\n    EPISODES --&gt;|are evaluated by| EVALUATORS\n    EVALUATORS --&gt;|produce| METRICS\n    METRICS --&gt;|are combined by| SHAPER\n    SHAPER --&gt;|produces| SHAPED\n    METRICS --&gt;|are translated by| WRITER\n    SHAPED --&gt;|is translated by| WRITER\n    WRITER --&gt;|creates and persists| REWARDS\n    REWARDS --&gt;|are stored in| STORE\n    RUNNER --&gt;|invokes| LEARNER\n    EPISODES --&gt;|supply behavior samples to| LEARNER\n    REWARDS --&gt;|supply aggregate signals to| LEARNER\n    LEARNER --&gt;|updates| POLICY\n    POLICY --&gt;|emits an advanced| NEXT\n    NEXT --&gt;|is persisted in| STORE\n    RUN --&gt;|records IDs of| EPISODES\n    RUN --&gt;|references its input| SNAPSHOT\n    RUN --&gt;|summarizes the resulting version of| NEXT\n\n    classDef trigger fill:#e8f1f8,stroke:#315f7d,color:#17202a,stroke-width:1.5px;\n    classDef state fill:#eaf4e8,stroke:#4d7047,color:#17202a,stroke-width:1.5px;\n    classDef runtime fill:#fff3d8,stroke:#8a6d2f,color:#17202a,stroke-width:1.5px;\n    classDef transient fill:#f1f2f4,stroke:#626b73,color:#17202a,stroke-width:1.5px;\n    classDef result fill:#f8e9e7,stroke:#8a5149,color:#17202a,stroke-width:1.5px;\n\n    class REQUEST trigger;\n    class STORE,SNAPSHOT,RUN,EPISODES,METRICS,REWARDS,NEXT state;\n    class ELIGIBILITY,POLICY,RUNNER,EVALUATORS,SHAPER,WRITER,LEARNER runtime;\n    class SHAPED transient;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TsJCGEloBUZN9AOJqUCd-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Training Request&lt;/b&gt;&#xa;Starts a manual, scheduled, or event-driven offline policy update." mermaidId="n:REQUEST" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#e8f1f8;strokeColor=#315f7d;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;Training Request&lt;/b&gt;&#xa;Starts a manual, scheduled, or event-driven offline policy update." id="TsJCGEloBUZN9AOJqUCd-2">
          <mxCell parent="TsJCGEloBUZN9AOJqUCd-1" style="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#e8f1f8;strokeColor=#315f7d;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="536" x="749" y="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Learning Store&lt;/b&gt;&#xa;Provides durable episodes, rewards, snapshots, and training-run records." mermaidId="n:STORE" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#eaf4e8;strokeColor=#4d7047;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;Learning Store&lt;/b&gt;&#xa;Provides durable episodes, rewards, snapshots, and training-run records." id="TsJCGEloBUZN9AOJqUCd-3">
          <mxCell parent="TsJCGEloBUZN9AOJqUCd-1" style="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#eaf4e8;strokeColor=#4d7047;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="583" x="1206" y="172" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Active Policy Snapshot&lt;/b&gt;&#xa;Identifies the current low-authority policy state and action taxonomy." mermaidId="n:SNAPSHOT" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#eaf4e8;strokeColor=#4d7047;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;Active Policy Snapshot&lt;/b&gt;&#xa;Identifies the current low-authority policy state and action taxonomy." id="TsJCGEloBUZN9AOJqUCd-4">
          <mxCell parent="TsJCGEloBUZN9AOJqUCd-1" style="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#eaf4e8;strokeColor=#4d7047;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="563" x="537" y="314" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Training Eligibility Gate&lt;/b&gt;&#xa;Admits a low-authority policy with enough completed episodes for the batch." mermaidId="n:ELIGIBILITY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#fff3d8;strokeColor=#8a6d2f;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;Training Eligibility Gate&lt;/b&gt;&#xa;Admits a low-authority policy with enough completed episodes for the batch." id="TsJCGEloBUZN9AOJqUCd-5">
          <mxCell parent="TsJCGEloBUZN9AOJqUCd-1" style="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#fff3d8;strokeColor=#8a6d2f;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="617" x="347" y="456" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Softmax Policy&lt;/b&gt;&#xa;Hydrates the active logits and baseline into an updateable runtime policy." mermaidId="n:POLICY" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#fff3d8;strokeColor=#8a6d2f;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="&lt;b&gt;Softmax Policy&lt;/b&gt;&#xa;Hydrates the active logits and baseline into an updateable runtime policy." id="TsJCGEloBUZN9AOJqUCd-6">
          <mxCell parent="TsJCGEloBUZN9AOJqUCd-1" style="html=1;whiteSpace=wrap;strokeWidth=1.5;fillColor=#fff3d8;strokeColor=#8a6d2f;fontColor=#17202a;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">
            <mxGeometry height="73" width="593" x="155" y="2018" as="geometry" />
          </mxCell>
