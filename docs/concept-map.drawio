  <diagram id="Q4kye9qUdkxrafQpb2Gn" name="RunTime">
    <mxGraphModel dx="836" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    AGENT[\&quot;&lt;b&gt;Agent&lt;/b&gt;&lt;br/&gt;Receives a recurring task and executes an authorized result.\&quot;]\n    TASK[\&quot;&lt;b&gt;Decision Task&lt;/b&gt;&lt;br/&gt;Names the reusable decision context for one agent-task pair.\&quot;]\n    STORE[\&quot;&lt;b&gt;Learning Store&lt;/b&gt;&lt;br/&gt;Provides the active policy and prior outcomes, then persists execution evidence.\&quot;]\n    SNAPSHOT[\&quot;&lt;b&gt;Active Policy Snapshot&lt;/b&gt;&lt;br/&gt;Holds the exact version, logits, authority, complexity metadata, and actions.\&quot;]\n    TASK_POLICY[\&quot;&lt;b&gt;Task Policy&lt;/b&gt;&lt;br/&gt;Wraps one active snapshot and exposes a unified decision operation.\&quot;]\n    ACTIONS[\&quot;&lt;b&gt;Action Taxonomy&lt;/b&gt;&lt;br/&gt;Defines the stable executable alternatives owned by the snapshot.\&quot;]\n    AUTHORITY[\&quot;&lt;b&gt;Decision Authority&lt;/b&gt;&lt;br/&gt;Routes low authority to learned selection and full authority to reasoned resolution.\&quot;]\n    SOFTMAX[\&quot;&lt;b&gt;Softmax Policy&lt;/b&gt;&lt;br/&gt;Uses learned probabilities to sample or select a policy-owned action.\&quot;]\n    FRAME[\&quot;&lt;b&gt;Decision Frame&lt;/b&gt;&lt;br/&gt;Supplies current criteria, constraints, options, and independent evidence.\&quot;]\n    RESOLVER[\&quot;&lt;b&gt;Decision Resolver&lt;/b&gt;&lt;br/&gt;Evaluates current evidence and finds a robust winner or requests more input.\&quot;]\n    RESULT[\&quot;&lt;b&gt;Decision Result&lt;/b&gt;&lt;br/&gt;Normalizes the selected or proposed action, status, rationale, and policy lineage.\&quot;]\n    HISTORY[\&quot;&lt;b&gt;Historical Outcomes&lt;/b&gt;&lt;br/&gt;Provides prior completed episodes, rewards, and explicit user feedback.\&quot;]\n    GATE[\&quot;&lt;b&gt;Autonomy and Approval Gate&lt;/b&gt;&lt;br/&gt;Combines result status, complexity, and learned evidence to govern confirmation.\&quot;]\n    EXECUTION[\&quot;&lt;b&gt;Agent Execution&lt;/b&gt;&lt;br/&gt;Runs the selected action after authorization or user confirmation.\&quot;]\n    CAPTURE[\&quot;&lt;b&gt;Episode Capture&lt;/b&gt;&lt;br/&gt;Observes the interaction, selected action, policy lineage, and outcome.\&quot;]\n    EPISODE[\&quot;&lt;b&gt;Episode&lt;/b&gt;&lt;br/&gt;Preserves the durable execution record consumed by scoring and learning.\&quot;]\n\n    AGENT --&gt;|undertakes| TASK\n    TASK --&gt;|requests the active policy from| STORE\n    STORE --&gt;|returns| SNAPSHOT\n    SNAPSHOT --&gt;|hydrates| TASK_POLICY\n    SNAPSHOT --&gt;|declares| ACTIONS\n    SNAPSHOT --&gt;|configures| AUTHORITY\n    TASK_POLICY --&gt;|reads| AUTHORITY\n    AUTHORITY --&gt;|delegates low-authority selection to| SOFTMAX\n    SNAPSHOT --&gt;|hydrates| SOFTMAX\n    ACTIONS --&gt;|bounds choices for| SOFTMAX\n    AUTHORITY --&gt;|delegates full-authority resolution to| RESOLVER\n    FRAME --&gt;|supplies current evidence to| RESOLVER\n    ACTIONS --&gt;|bounds options for| RESOLVER\n    SOFTMAX --&gt;|normalizes its choice into| RESULT\n    RESOLVER --&gt;|emits| RESULT\n    STORE --&gt;|returns| HISTORY\n    SNAPSHOT --&gt;|supplies complexity and confidence to| GATE\n    HISTORY --&gt;|supplies observed evidence to| GATE\n    RESULT --&gt;|is governed by| GATE\n    GATE --&gt;|authorizes or requests confirmation for| EXECUTION\n    RESULT --&gt;|provides the selected action to| EXECUTION\n    EXECUTION --&gt;|is observed by| CAPTURE\n    CAPTURE --&gt;|creates or completes| EPISODE\n    EPISODE --&gt;|is persisted through| STORE\n\n    classDef identity fill:#e8f1f8,stroke:#315f7d,color:#17202a,stroke-width:1.5px;\n    classDef state fill:#eaf4e8,stroke:#4d7047,color:#17202a,stroke-width:1.5px;\n    classDef runtime fill:#fff3d8,stroke:#8a6d2f,color:#17202a,stroke-width:1.5px;\n    classDef evidence fill:#f1f2f4,stroke:#626b73,color:#17202a,stroke-width:1.5px;\n    classDef outcome fill:#f8e9e7,stroke:#8a5149,color:#17202a,stroke-width:1.5px;\n\n    class AGENT,TASK identity;\n    class STORE,SNAPSHOT,ACTIONS,EPISODE state;\n    class TASK_POLICY,AUTHORITY,SOFTMAX,RESOLVER,GATE,EXECUTION,CAPTURE runtime;\n    class FRAME,HISTORY evidence;\n    class RESULT outcome;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JbiP2ET93n0CbPQwfH8w-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
